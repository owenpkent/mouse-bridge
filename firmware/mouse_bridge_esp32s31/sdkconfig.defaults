CONFIG_IDF_TARGET="esp32s31"

# Bluetooth Classic HID host. Classic needs Bluedroid; NimBLE is BLE only.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y

# USB mouse. The faster tick keeps the wait for a free USB report short.
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_FREERTOS_HZ=1000

# Bluedroid doesn't fit the default 1 MB app partition.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
